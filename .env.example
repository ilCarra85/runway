# Copia questo file in .env.local e inserisci i valori creati su Google Cloud (progetto "Runway").
# Senza questi valori l'app funziona solo in locale, senza sync.

# ID client OAuth (tipo: Applicazione web), finisce con .apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Chiave API limitata a Google Picker API e ai siti dell'app (inizia con AIza): serve al selettore di cartelle Drive
VITE_GOOGLE_API_KEY=
